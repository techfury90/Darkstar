RegDef[rhE,	RH,	0C];	{Ether}
RegDef[rFrh,	RH,	0C];	{Booting - SAxx00Initial, TridentInitial}

RegDef[EE,	R,	0D];	{Ether}
RegDef[rN,	R,	0D];	{Protected}
