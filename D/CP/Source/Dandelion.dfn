Set[CCtlTag, 20];
Set[CHdTag, 40];
Set[CCylTag, 80];

Set[CHdAdv, 1];
Set[CRead, 40];
Set[CRstAtt, 40]; 		{this is actually the Read bit}

Set[CMaxSec, 1D];
Set[CRetry, 5A]; 		{look at 90 headers before giving up}

Set[CMemError, 0E];
Set[CHdrNotFnd, 10];
Set[CRecalError, 20];

